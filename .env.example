# LexPlatform — переменные окружения (скопируйте в .env)
APP_ENV=dev

POSTGRES_USER=lex
POSTGRES_PASSWORD=lex_secret
POSTGRES_DB=lexplatform

RABBITMQ_USER=lex
RABBITMQ_PASSWORD=lex_secret

MINIO_ROOT_USER=lexminio
MINIO_ROOT_PASSWORD=lexminio_secret
S3_BUCKET=lex-media

JWT_PASSPHRASE=change_me_in_production

# Production only
# SENTRY_DSN=
# OPENAI_API_KEY=

# LiqPay (sandbox-ключи из кабинета liqpay.ua)
LIQPAY_PUBLIC_KEY=sandbox_public_key
LIQPAY_PRIVATE_KEY=sandbox_private_key
APP_PUBLIC_URL=http://localhost:8080
