# Non-secret defaults; override credentials and keys in the deployment environment.
APP_ENV=dev
APP_DEBUG=0
APP_SECRET=change-me
APP_DEBUG_ERRORS=0
DATABASE_URL="postgresql://lex:lex_secret@127.0.0.1:5432/lexplatform?serverVersion=16&charset=utf8"
MESSENGER_TRANSPORT_DSN=in-memory://
MAILER_DSN=null://null
OPENSEARCH_URL=http://localhost:9200
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
CORS_ALLOW_ORIGIN='^https?://localhost(:[0-9]+)?$'
LIQPAY_PUBLIC_KEY=unset
LIQPAY_PRIVATE_KEY=unset
APP_PUBLIC_URL=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_KEY=unset
S3_SECRET=unset
S3_BUCKET=lex-media
S3_PUBLIC_URL=
