# ── LexPlatform · STAGING ──
# Скопіюйте у .env на сервері та замініть ВСІ значення-заглушки.
# Згенерувати пароль: openssl rand -hex 24

APP_ENV=prod

# Публічний домен staging (без слеша в кінці). Має вказувати A-записом на IP VPS.
STAGING_DOMAIN=staging.example.com
APP_PUBLIC_URL=https://staging.example.com

# PostgreSQL
POSTGRES_USER=lex
POSTGRES_PASSWORD=CHANGE_ME_db
POSTGRES_DB=lexplatform

# RabbitMQ
RABBITMQ_USER=lex
RABBITMQ_PASSWORD=CHANGE_ME_rabbit

# MinIO (S3-сумісне сховище)
MINIO_ROOT_USER=lexminio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
S3_BUCKET=lex-media
# S3_PUBLIC_URL формується автоматично як APP_PUBLIC_URL/media (Caddy проксує на MinIO).
# Окремо задавати не потрібно.

# JWT (парольна фраза для ключів; ключі генеруються автоматично на старті)
JWT_PASSPHRASE=CHANGE_ME_jwt

# Пошта: null://null = листи мовчки відкидаються (лог чистий).
# Для реальних листів: smtp://apikey:KEY@smtp.sendgrid.net:587
MAILER_DSN=null://null

# CORS: дозволений origin для API. Для одного домену:
#   ^https://staging\.example\.com$
# За замовчуванням дозволяє будь-який https-домен (зручно для тесту).
CORS_ALLOW_ORIGIN=^https://staging\.example\.com$

# LiqPay (sandbox-ключі з кабінету liqpay.ua для тесту)
LIQPAY_PUBLIC_KEY=sandbox_iXXXXXXXXXX
LIQPAY_PRIVATE_KEY=sandbox_XXXXXXXXXXXXXXXXXXXX
